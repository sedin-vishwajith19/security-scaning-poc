// Security scans POC: gitleaks (secrets) + KICS (Dockerfile / Docker Compose)
// Plugins needed: Pipeline, Git, Pipeline Utility Steps (readJSON)
// Tools needed in the Jenkins container: gitleaks (/usr/local/bin), KICS (/opt/kics)

pipeline {
  agent any

  parameters {
    booleanParam(name: 'ENFORCE_SECRET_SCAN', defaultValue: false,
                 description: 'Fail the build on blocking secret findings (gitleaks)')
    booleanParam(name: 'ENFORCE_CONFIG_SCAN', defaultValue: false,
                 description: 'Fail the build on blocking Dockerfile/Compose findings (KICS)')
  }

  options {
    timestamps()
    skipDefaultCheckout()   // avoid the double checkout seen in the gitleaks POC
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    // ------------------------------------------------------------------
    stage('Secret scan (gitleaks)') {
      steps {
        sh '''
          gitleaks git . \
            --config .gitleaks.toml \
            --redact \
            --report-format json \
            --report-path gitleaks-report.json \
            --exit-code 0
        '''
        script {
          def findings = readJSON(file: 'gitleaks-report.json') ?: []
          def nonBlockingRules = ['generic-api-key', 'jwt']
          def blocking = findings.findAll { !(it.RuleID in nonBlockingRules) }

          echo "gitleaks: ${findings.size()} finding(s) | blocking: ${blocking.size()}"
          findings.each { f -> echo "  [${f.RuleID}] ${f.File}:${f.StartLine}  commit=${f.Commit}" }

          if (blocking && params.ENFORCE_SECRET_SCAN) {
            error("🔴 Secret scan failed: ${blocking.size()} blocking finding(s).")
          } else if (findings) {
            unstable("🟠 Secret scan found ${findings.size()} issue(s).")
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true }
      }
    }

    // ------------------------------------------------------------------
    stage('Config scan (KICS: Dockerfile + Compose)') {
      steps {
        // KICS loads its rules from ./assets relative to where it runs,
        // so we run it from /opt/kics and point -p at the workspace.
        sh '''
          mkdir -p "$WORKSPACE/kics-results"
          cd /opt/kics
          kics scan \
            -p "$WORKSPACE" \
            -o "$WORKSPACE/kics-results" \
            --type Dockerfile,DockerCompose \
            --report-formats json,html \
            --ignore-on-exit results \
            --ci
        '''
        // --ignore-on-exit results : findings never fail this step by themselves
        //                            (we decide below). Engine errors still fail it.

        script {
          def report = readJSON(file: 'kics-results/results.json')

          // 🔴 FAIL: our blocking rules (KICS query IDs)
          def blockingIds = [
            'a88baa34-e2ad-44ea-ad6f-8cac87bc7c71', // Passwords And Secrets (ENV/ARG, compose environment)
            'ae5b6871-7f45-42e0-bb4c-ab300c4d2026', // Privileged Containers Enabled
            'd6355c88-1e8d-49e9-b2f2-f8a1ca12c75b', // Docker Socket Mounted In Container
          ]

          // 🟡 ADVISORY: KICS rates these MEDIUM, our policy treats them as advisory
          def advisoryIds = [
            '9513a694-aa0d-41d8-be61-3271e056f36b', // Add Instead of Copy
            '965a08d7-ef86-4f14-8792-4a3b2098937e', // Apt Get Install Pin Version Not Defined
            'd3499f6d-1651-41bb-a9a7-de925fea487b', // Unpinned Package Version in Apk Add
            '02d9c71f-3ee8-4986-9c27-1a20d0d19bfc', // Unpinned Package Version in Pip Install
            'e36d8880-3f78-4546-b9a1-12f0745ca0d5', // NPM Install Command Without Pinned Version
            '22cd11f7-9c6c-4f6e-84c0-02058120b341', // Gem Install Without Version
            '93d88cf7-f078-46a8-8ddc-178e03aeacf1', // Missing Version Specification In dnf install
            '6452c424-1d92-4deb-bb18-a03e95d579c4', // Yum install Without Version
            '698ed579-b239-4f8f-a388-baa4bcb13ef8', // Healthcheck Not Set (compose)
            'bb9ac4f7-e13b-423d-a010-c74a1bfbe492', // Memory Not Limited
            '221e0658-cb2a-44e3-b08a-db96a341d6fa', // Pids Limit Not Set
            '2fc99041-ddad-49d5-853f-e35e70a48391', // Restart Policy On Failure Not Set To 5
            '610e266e-6c12-4bca-9925-1ed0cd29742b', // Security Opt Not Set
            'b86987e1-6397-4619-81d5-8807f2387c79', // Not Using JSON In CMD And ENTRYPOINT
            '8a301064-c291-4b20-adcb-403fe7fd95fd', // Changing Default Shell Using RUN Command
          ]

          def blocking = []
          def mustFix  = []
          def advisory = []
          def prefix   = env.WORKSPACE + '/'

          (report.queries ?: []).each { q ->
            def level
            if (blockingIds.contains(q.query_id))        { level = 'FAIL' }
            else if (advisoryIds.contains(q.query_id))   { level = 'ADVISORY' }
            else if (q.severity in ['CRITICAL', 'HIGH', 'MEDIUM']) { level = 'MUST-FIX' }
            else                                          { level = 'ADVISORY' }

            (q.files ?: []).each { f ->
              def line = "[${q.severity}] ${q.query_name} -> ${f.file_name.replace(prefix, '')}:${f.line}"
              if (level == 'FAIL')          { blocking << line }
              else if (level == 'MUST-FIX') { mustFix  << line }
              else                          { advisory << line }
            }
          }

          echo "KICS: 🔴 fail: ${blocking.size()} | 🟠 must-fix: ${mustFix.size()} | 🟡 advisory: ${advisory.size()}"
          if (blocking) { echo "🔴 FAIL:\n  " + blocking.join('\n  ') }
          if (mustFix)  { echo "🟠 MUST FIX:\n  " + mustFix.join('\n  ') }
          if (advisory) { echo "🟡 ADVISORY:\n  " + advisory.join('\n  ') }

          if (blocking && params.ENFORCE_CONFIG_SCAN) {
            error("🔴 Config scan failed: ${blocking.size()} blocking finding(s). See kics-results/results.html")
          } else if (blocking || mustFix) {
            unstable("🟠 Config scan found issues. See kics-results/results.html")
          } else {
            echo "✅ No blocking or must-fix config issues"
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'kics-results/**', allowEmptyArchive: true }
      }
    }
  }
}