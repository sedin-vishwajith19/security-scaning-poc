// Load the shared library registered as 'security-lib'
@Library('security-lib') _

pipeline {
  agent any

  environment {
    // Docker image name for this build
    IMAGE_NAME = "myapp:${BUILD_NUMBER}"

    // POC: the Jenkins container has no Docker, so we cannot build IMAGE_NAME.
    // Trivy scans this registry image instead (pulled directly, no Docker needed).
    //   python:3.13-slim -> 0 CRITICAL      (gate passes)
    //   python:3.7-slim  -> 13 fixable CRIT (gate fails)
    TRIVY_IMAGE = "python:3.13-slim"

    // Redmine Configuration
    REDMINE_URL = "http://host.docker.internal:3000" // Use IP/domain if Jenkins is remote
    REDMINE_PROJECT = "security"
  }

  stages {
    stage('Checkout Code') {
      steps {
        checkout scm
      }
    }

    stage('Security: Secrets Scan (Gitleaks)') {
      steps {
        script {
          // 1. Scan full Git history for committed secrets
          def findings = securityScan.gitleaks(
            report: 'gitleaks-report.json'
          )

          // 2. Automatically create Redmine tickets for any secrets found
          // (Deduplicates tickets automatically via [SEC-<hash>] marker)
          redmineTicket(
            findings     : findings,
            url          : env.REDMINE_URL,
            project      : env.REDMINE_PROJECT,
            credentialsId: 'redmine-api-key',
            dryRun       : false,              // Set true to test without creating tickets
            maxTickets   : 10
          )
        }
      }
    }

    stage('Security: SAST & IaC (Semgrep)') {
      steps {
        script {
          // Scans Dockerfile, docker-compose.yml + application code
          securityScan.semgrep(
            languages: ['python', 'javascript'],
            report   : 'semgrep-report.json'
          )
        }
      }
    }

    stage('Build Container Image') {
      steps {
        // POC: no Docker in the Jenkins container. Real pipelines run:
        //   sh "docker build -t ${IMAGE_NAME} ."
        echo "Skipping docker build of ${IMAGE_NAME} (no Docker in Jenkins). Trivy will scan ${TRIVY_IMAGE}."
      }
    }

    stage('Security: Container Vulnerability Scan (Trivy)') {
      steps {
        script {
          // Policy: Fails the build if fixable CRITICAL CVEs > maxCritical
          trivyScan(
            image       : env.TRIVY_IMAGE,
            maxCritical : 0,           // Strict: 0 fixable CRITICALs allowed
            onlyFixable : true,        // Ignore unfixable/upstream zero-days
            report      : 'trivy-report.json'
          )
        }
      }
    }

    stage('Deploy') {
      steps {
        echo "All security quality gates passed! Ready to deploy ${IMAGE_NAME}."
      }
    }
  }

  post {
    always {
      sh 'rm -rf .security'
    }
    unstable {
      echo "⚠️ Build completed with warnings (Secrets or Semgrep issues detected). Check archived reports."
    }
    failure {
      echo "❌ Build failed! (Trivy found unacceptable CRITICAL vulnerabilities or compile error)."
    }
  }
}
